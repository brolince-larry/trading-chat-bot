# Copy to .env and fill in real values. Never commit .env.

APP_NAME="Forex AI Market Scanner"
ENVIRONMENT=development

# postgresql+psycopg://<user>:<password>@<host>:5432/<database>
DATABASE_URL=postgresql+psycopg://forex:forex@localhost:5432/forex_ai

# "simulated" (default, no credentials required) or "oanda"
MARKET_DATA_PROVIDER=simulated

# Required only when MARKET_DATA_PROVIDER=oanda. Never commit a real key.
OANDA_API_KEY=
OANDA_USE_PRACTICE=true

DEFAULT_ACCOUNT_CURRENCY=USD
DEFAULT_RISK_PERCENT=1.0

# Comma-separated list is not supported directly by pydantic-settings list
# parsing from env vars without a JSON array; set as a JSON list, e.g.:
# CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
